# Required - Stream > your video library > API
BUNNY_STREAM_LIBRARY_ID=YOUR_NUMERIC_LIBRARY_ID
BUNNY_STREAM_API_KEY=YOUR_VIDEO_LIBRARY_API_KEY

# Required for signed webhook verification (the library Read-Only API key)
BUNNY_STREAM_READ_ONLY_API_KEY=YOUR_VIDEO_LIBRARY_READ_ONLY_API_KEY

# Optional - only set after enabling Embed View Token Authentication in Bunny
BUNNY_STREAM_TOKEN_AUTH_KEY=YOUR_TOKEN_AUTHENTICATION_KEY

# Optional defaults - normally leave these exactly as shown
BUNNY_STREAM_API_URL=https://video.bunnycdn.com
BUNNY_STREAM_PLAYER_URL=https://player.mediadelivery.net
BUNNY_STREAM_TUS_URL=https://video.bunnycdn.com/tusupload
BUNNY_STREAM_TUS_EXPIRATION_SECONDS=86400

# Configure this URL in Bunny Stream; it is not a Vercel variable:
# https://www.heycybercorp.fr/api/bunny/webhook
